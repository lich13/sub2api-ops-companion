{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sub2Ops",
  "version": "0.1.109",
  "identifier": "com.lich13.sub2ops",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "android": { "minSdkVersion": 31 },
    "targets": ["app", "dmg"],
    "macOS": { "minimumSystemVersion": "14.0", "signingIdentity": "-", "infoPlist": "Info.plist" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
