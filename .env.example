DATABASE_URL=postgresql://sub2api:sub2api@sub2api-postgres:5432/sub2api?sslmode=disable
OPS_BASIC_USER=admin
OPS_BASIC_PASSWORD=change-this-password
OPS_SESSION_SECRET=change-this-long-random-session-secret
OPS_SESSION_TTL_SECONDS=31536000
BASE_PATH=/sub2ops
APP_PORT=18081
GUARD_ENABLED=true
GUARD_INTERVAL_SECONDS=5
GUARD_LOOKBACK_MINUTES=60
GUARD_BALANCE_ERROR_THRESHOLD=1
TELEGRAM_CONFIG_PATH=/data/telegram-config.json
TELEGRAM_BOT_TOKEN=
TELEGRAM_STATE_PATH=/data/telegram-state.json
OPS_UPDATE_ENABLED=true
OPS_UPDATE_WORKDIR=/workspace
OPS_UPDATE_BRANCH=main
OPS_UPDATE_SSH_KEY_PATH=/data/github-deploy-key
OPS_CONTAINER_USER=10001:10001
