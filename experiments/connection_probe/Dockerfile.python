FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY app ./app
COPY experiments/connection_probe/python_slice.py ./experiments/connection_probe/python_slice.py
RUN useradd --system --uid 10001 probe
USER probe
ENTRYPOINT ["python", "-m", "experiments.connection_probe.python_slice"]
