FROM rust:1.94.1-slim-bookworm AS build
WORKDIR /build
COPY experiments/connection_probe/rust/Cargo.toml experiments/connection_probe/rust/Cargo.lock ./
COPY experiments/connection_probe/rust/src ./src
ENV RUSTFLAGS="--remap-path-prefix=/build=/src"
RUN rustup component add clippy \
    && cargo test --locked \
    && cargo clippy --locked --all-targets -- -D warnings \
    && cargo build --release --locked

FROM debian:bookworm-slim
RUN useradd --system --uid 10001 probe
COPY --from=build /build/target/release/sub2ops-probe /usr/local/bin/sub2ops-probe
USER probe
ENTRYPOINT ["/usr/local/bin/sub2ops-probe"]
