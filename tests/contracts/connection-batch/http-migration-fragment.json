      "legacy_test_id": "py:tests.test_connection_batch_http039:ConnectionBatchHttp039Tests.test_account_busy_requeue_clears_dispatch_time_and_remains_cancellable",
      "status": "mapped",
      "target": {
        "kind": "rust_test",
        "path": "server/tests/account_mutation_parity.rs",
        "test_name": "connection_http_late_account_busy_requeues_without_dispatch_time_and_can_cancel",
        "assertions": [
          "assert_eq!(accepted.0, 202)",
          "assert_eq!(queued[\"items\"][0][\"status\"], \"queued\")",
          "assert!(queued[\"items\"][0].get(\"started_at\").is_some())",
          "assert_eq!(queued[\"items\"][0][\"started_at\"], Value::Null)",
          "assert_eq!(\n        h.runtime.operations.store.read().unwrap()[\"jobs\"][&jid][\"started_at\"],\n        Value::Null\n    )",
          "assert_eq!(cancelled.0, 200)",
          "assert_eq!(cancelled.1[\"pending\"], 0)",
          "assert_eq!(cancelled.1[\"items\"][0][\"status\"], \"cancelled\")",
          "assert_eq!(h.batch_listing(&bid).await, cancelled.1)",
          "assert!(manual_writes(&h).is_empty())"
        ]
      },
      "coverage_note": "Acquiring the account lease behind a real authentication gate forces a late busy response; the durable queued record clears started_at and cancels permanently without native test requests."
    },
