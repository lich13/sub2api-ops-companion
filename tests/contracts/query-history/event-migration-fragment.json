      "legacy_test_id": "py:tests.test_events030:EventQuery030Tests.test_default_category_preserves_legacy_predicate_and_rejects_unknown_categories",
      "status": "mapped",
      "target": {
        "kind": "rust_test",
        "path": "server/tests/query_history_contract.rs",
        "test_name": "event_pagination_matches_pinned_python_across_category_account_pages",
        "assertions": [
          "assert_eq!(fixed[\"reference_sha\"], REFERENCE_SHA)",
          "assert_eq!(oracle[\"reference_sha\"], REFERENCE_SHA)",
          "assert_eq!(\n        removed_unrelated_event.rows_affected(),\n        1,\n        \"temporary business schema must start with its one unrelated fixture event\"\n    )",
          "assert_eq!(actual_scopes, expected_scopes)",
          "assert_eq!(\n                actual_ids, page_expected,\n                \"pinned Python page mismatch for category={category:?}, account={account_id:?}, page={index}\"\n            )",
          "assert!(\n                actual_ids.iter().all(|id| !seen.contains(id)),\n                \"Rust pagination overlapped pages for category={category:?}, account={account_id:?}\"\n            )",
          "assert_eq!(actual[\"next_cursor\"].as_i64(), expected_cursor)",
          "assert_eq!(expected_cursor, actual_ids.last().copied())",
          "assert_eq!(\n            seen, expected_ids,\n            \"all pages must preserve the old filter result\"\n        )",
          "assert_eq!(\n            cursor, None,\n            \"the final Rust page must terminate pagination\"\n        )",
          "assert_eq!(combinations, 12, \"three categories × four account scopes\")",
          "assert_eq!(actual.unwrap_err().status.as_u16(), 404)",
          "assert_eq!(actual.unwrap(), expected[\"value\"], \"event detail {id}\")",
          "assert_eq!(\n            queries\n                .errors(None, None, 2, Some(category))\n                .await\n                .unwrap_err()\n                .status\n                .as_u16(),\n            422\n        )",
          "assert_eq!(\n            queries\n                .error_detail(1, Some(category))\n                .await\n                .unwrap_err()\n                .status\n                .as_u16(),\n            422\n        )",
          "assert_eq!(logged_statements(\"query-history-events\"), before_invalid)"
        ],
        "helper_assertions": [
          {
            "name": "assert_event_routes_match_queries",
            "assertions": [
              "assert_eq!(request.method(), Method::GET)",
              "assert_eq!(request.headers().get(\"x-api-key\").unwrap(), ADMIN_KEY)",
              "assert!(request.headers().get(\"authorization\").is_none())",
              "assert_eq!(response.status().as_u16(), 200)",
              "assert_eq!(\n                body[\"items\"]\n                    .as_array()\n                    .unwrap()\n                    .iter()\n                    .map(|v| v[\"id\"].clone())\n                    .collect::<Vec<_>>(),\n                page[\"ids\"].as_array().unwrap().clone()\n            )",
              "assert_eq!(body[\"next_cursor\"], page[\"next_cursor\"])",
              "assert_eq!(\n            response.status().as_u16(),\n            expected[\"status\"].as_u64().unwrap() as u16\n        )",
              "assert_eq!(response.json::<Value>().await.unwrap(), expected[\"value\"])",
              "assert_eq!(response.status().as_u16(), 422)",
              "assert_eq!(logged_statements(\"query-history-events-http\"), before)"
            ]
          }
        ]
      },
      "coverage_note": "Pinned Python and Rust query the same synthetic PostgreSQL events, including orphan/deleted entities: all pages across three categories and four account scopes plus full detail DTOs/404 are compared. Actual Axum routes repeat list/detail comparisons; invalid categories return 422 before any SQL, proven from the isolated PostgreSQL statement log."
    },
