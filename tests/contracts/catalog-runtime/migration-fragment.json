      "legacy_test_id": "py:tests.test_desktop_api:DesktopEvidenceTests.test_invalidation_never_waits_for_an_inflight_snapshot",
      "status": "mapped",
      "target": {
        "kind": "rust_test",
        "path": "server/tests/catalog_runtime_parity.rs",
        "test_name": "snapshot_invalidation_never_waits_or_republishes_inflight_cache",
        "assertions": [
          "assert!(!inflight.is_finished())",
          "assert_eq!(first[\"accounts\"][0][\"name\"], \"fixture-inflight\")",
          "assert_eq!(second[\"accounts\"][0][\"name\"], \"fixture-after\")",
          "assert_eq!(\n        harness.runtime.snapshot().await.unwrap(),\n        second,\n        \"the subsequent uncontended snapshot is cached normally\"\n    )",
          "assert!(harness.mock.calls.lock().unwrap().is_empty())"
        ]
      },
      "coverage_note": "A real PostgreSQL lock suspends snapshot construction; invalidation finishes within 100ms while it is blocked. After release, a newer database change is visible immediately without another invalidation, and the next uncontended snapshot is cached normally."
    },
