      "legacy_test_id": "py:tests.test_model_catalog:StoreTests.test_atomic_permissions_conflict_restart_and_corruption",
      "status": "mapped",
      "target": {
        "kind": "rust_test",
        "path": "server/tests/catalog_runtime_parity.rs",
        "test_name": "model_store_atomic_permissions_restart_conflict_and_corruption",
        "assertions": [
          "assert_eq!(\n        fs::metadata(&path).unwrap().permissions().mode() & 0o777,\n        0o600\n    )",
          "assert_eq!(\n        ModelConfig::new(path.clone(), false).group(7).unwrap(),\n        saved\n    )",
          "assert_eq!(\n        names,\n        [\"model.json\".to_owned(), \"model.json.lock\".to_owned()].into()\n    )",
          "assert_eq!(\n        store\n            .save(7, &json!({}), initial[\"revision\"].as_str().unwrap())\n            .unwrap_err()\n            .status\n            .as_u16(),\n        409\n    )",
          "assert!(store\n        .save(7, &json!({}), saved[\"revision\"].as_str().unwrap())\n        .is_err())",
          "assert_eq!(fs::read(&path).unwrap(), b\"{\")"
        ]
      },
      "coverage_note": "Atomic state replacement keeps 0600 permissions, revision conflicts reject stale writes, restart preserves saved overrides and corrupt bytes cannot be replaced."
    },
    {
      "legacy_test_id": "py:tests.test_model_catalog:StoreTests.test_parallel_stores_do_not_lose_another_group",
