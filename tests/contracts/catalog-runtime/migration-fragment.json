      "status": "mapped",
      "target": {
        "kind": "rust_test",
        "path": "server/tests/catalog_runtime_parity.rs",
        "test_name": "native_auth_on_every_hit_group_isolation_etag_and_forwarded_identity",
        "assertions": [
          "assert_eq!(first.status, 200)",
          "assert_eq!(body[\"models\"][0][\"display_name\"], \"Seven\")",
          "assert_eq!(\n        body[\"models\"][0][\"unknown\"],\n        native()[\"models\"][0][\"unknown\"]\n    )",
          "assert_eq!(body[\"future_envelope\"], native()[\"future_envelope\"])",
          "assert_eq!(cached.status, 304)",
          "assert!(cached.body.is_empty())",
          "assert_eq!(h.mock.calls.lock().unwrap().len(), 2)",
          "assert_eq!(\n        serde_json::from_slice::<Value>(&other.body).unwrap(),\n        native()\n    )",
          "assert_eq!(rejected.status, 401)",
          "assert_eq!(\n        serde_json::from_slice::<Value>(&rejected.body).unwrap(),\n        json!({\"error\":\"fixture-revoked\"})\n    )",
          "assert_eq!(calls.len(), 4)",
          "assert_eq!(call[\"method\"], \"GET\")",
          "assert_eq!(call[\"path\"], format!(\"/v1/models?{QUERY}\"))",
          "assert_eq!(call[\"x-real-ip\"], \"127.0.0.1\")",
          "assert_eq!(call[\"if-none-match\"], \"\")",
          "assert_eq!(\n            call[\"authorization\"],\n            format!(\"Bearer fixture-caller-{}\", if index == 2 { 8 } else { 7 })\n        )"
        ]
      },
      "coverage_note": "Real loopback HTTP verifies four native GETs, group isolation, ETag 304 only after authentication, revoked 401, forwarded authorization/IP and unchanged native fields."
    },
