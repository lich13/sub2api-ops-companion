      "legacy_test_id": "py:tests.test_model_catalog:CatalogTests.test_invalid_config_and_database_failure_return_unchanged_native",
      "status": "mapped",
      "target": {
        "kind": "rust_test",
        "path": "server/tests/catalog_runtime_parity.rs",
        "test_name": "corrupt_config_and_database_failure_preserve_native_catalog_and_private_status",
        "assertions": [
          "assert_eq!(fallback.status, 200)",
          "assert_eq!(\n        serde_json::from_slice::<Value>(&fallback.body).unwrap(),\n        native()\n    )",
          "assert_eq!(fallback.headers[\"x-sub2ops-catalog\"], \"fallback\")",
          "assert_eq!(h.runtime.catalog.status()[\"state\"], \"fallback\")",
          "assert_eq!(\n        fs::read(&h.runtime.settings.model_path).unwrap(),\n        b\"{fixture-private-invalid\"\n    )",
          "assert_eq!(unavailable.status, 200)",
          "assert_eq!(\n        serde_json::from_slice::<Value>(&unavailable.body).unwrap(),\n        native()\n    )",
          "assert_eq!(unavailable.headers[\"x-sub2ops-catalog\"], \"fallback\")",
          "assert!(!h\n        .runtime\n        .catalog\n        .status()\n        .to_string()\n        .contains(\"fixture-private\"))",
          "assert_eq!(h.mock.calls.lock().unwrap().len(), 2)"
        ]
      },
      "coverage_note": "Malformed on-disk config and a closed database both return the full native JSON with fallback status; private error content and damaged bytes remain protected."
    },
