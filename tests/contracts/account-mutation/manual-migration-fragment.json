        "path": "server/tests/account_mutation_parity.rs",
        "test_name": "management_auth_cache_refresh_and_invalid_keys_never_expose_key_in_url",
        "assertions": [
          "assert_eq!(h.upstream.calls().len(), 1)",
          "assert_eq!(h.upstream.calls().len(), 2)",
          "assert_eq!(\n            h.runtime\n                .upstream\n                .authenticate(key, false)\n                .await\n                .err()\n                .unwrap()\n                .status\n                .as_u16(),\n            401\n        )",
          "assert_eq!(\n        calls.len(),\n        3,\n        \"empty and newline keys never reach upstream\"\n    )",
          "assert!(calls\n        .iter()\n        .all(|c| c.method == Method::GET && c.uri == \"/api/v1/admin/groups/all\"))",
          "assert!(calls.iter().all(|c| !c.uri.contains(ADMIN_KEY)))",
          "assert!(!h.runtime.upstream.status().to_string().contains(ADMIN_KEY))",
          "assert!(manual_writes(&h).is_empty())"
        ]
      },
      "coverage_note": "Real native authentication caches reads, refreshes writes, rejects invalid credentials and never places keys in request URLs or public status."
    },
