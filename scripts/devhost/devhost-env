#!/bin/sh
# Sourceable entrypoint; all repository selection and exports share devhost.py.
devhost_env_home=${DEVHOST_HOME:-${DEVHOST_ROOT:-/workspace}/devhost}
devhost_env_program=$devhost_env_home/lib/devhost.py
if [ ! -r "$devhost_env_program" ]; then
    printf '%s\n' 'Install devhost before sourcing its environment.' >&2
    unset devhost_env_home devhost_env_program
    return 64
fi
if devhost_env_exports=$(/usr/bin/python3 -B "$devhost_env_program" shell-env --cwd "$PWD" --repo "${DEVHOST_REPO:-}"); then
    eval "$devhost_env_exports"
else
    unset devhost_env_home devhost_env_program devhost_env_exports
    return 64
fi
unset devhost_env_home devhost_env_program devhost_env_exports
