#!/usr/bin/env python3
"""Use the enrolled project's pnpm and store without leaking npm config."""
import os
from pathlib import Path
import sys
root = Path(os.environ.get('DEVHOST_ROOT', '/workspace'))
base = Path(os.environ.get('DEVHOST_HOME', str(root / 'devhost')))
sys.path.insert(0, str(base / 'lib'))
from repositories import PROFILES, canonical, from_directory
try:
    repo = from_directory(Path.cwd(), root) or os.environ.get('DEVHOST_REPO')
    profile = PROFILES[canonical(repo)] if repo else None
    if profile and profile['package_manager'] != 'pnpm':
        raise ValueError('This repository does not use pnpm; use its declared package manager.')
    version = profile['package_manager_version'] if profile else '11.6.0'
except ValueError as exc:
    print(str(exc), file=sys.stderr)
    raise SystemExit(64)
for key in ('npm_config_store_dir', 'NPM_CONFIG_STORE_DIR'):
    os.environ.pop(key, None)
corepack = str(base / 'toolchains/corepack/bin/corepack')
os.execv(corepack, [corepack, 'pnpm@' + version, '--store-dir', str(root / 'cache/pnpm-store'), *sys.argv[1:]])
