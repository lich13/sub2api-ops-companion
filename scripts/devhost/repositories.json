    "NexusHub": {
      "directory": "nexushub",
      "package_manager": "pnpm",
      "package_manager_version": "11.0.8",
      "frontend": "webui",
      "python": null,
      "rust_manifest": "Cargo.toml",
      "prepare": [
        {
          "name": "frontend-install",
          "cwd": "webui",
          "argv": [
            "pnpm",
            "install",
            "--frozen-lockfile"
          ]
        }
      ],
      "check": [
        {
          "name": "rust-tests",
          "cwd": ".",
          "argv": [
            "cargo",
            "test",
            "--workspace",
            "--locked"
          ]
        },
        {
          "name": "rust-clippy",
          "cwd": ".",
          "argv": [
            "cargo",
            "clippy",
            "--workspace",
            "--all-targets",
            "--locked",
            "--",
            "-D",
            "warnings"
          ]
        },
        {
          "name": "frontend-tests",
          "cwd": "webui",
          "argv": [
            "pnpm",
            "test"
          ]
        },
        {
          "name": "frontend-types",
          "cwd": "webui",
          "argv": [
            "pnpm",
            "typecheck"
          ]
        },
        {
          "name": "frontend-build",
          "cwd": "webui",
          "argv": [
            "pnpm",
            "build:tauri"
          ]
        }
      ],
      "ci_platforms": [
        "linux-browser",
        "macos"
      ]
    },
